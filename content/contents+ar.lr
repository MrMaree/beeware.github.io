import toga
from toga.style import Pack
from toga.style.pack import COLUMN, ROW


class ECommerceApp(toga.App):
    def startup(self):
        # إنشاء نافذة التطبيق
        main_box = toga.Box(style=Pack(direction=COLUMN, padding=10))

        # عنوان التطبيق
        title_label = toga.Label(
            "مرحبًا بك في متجرنا الإلكتروني!",
            style=Pack(font_size=20, padding=(0, 10))
        )
        main_box.add(title_label)

        # قائمة المنتجات
        self.products = [
            {"name": "منتج 1", "price": 100},
            {"name": "منتج 2", "price": 200},
            {"name": "منتج 3", "price": 300}
        ]

        self.cart = []  # سلة التسوق

        self.product_list = toga.Box(style=Pack(direction=COLUMN, padding=10))
        self.display_products()
        main_box.add(self.product_list)

        # زر لعرض السلة
        cart_button = toga.Button(
            "عرض السلة",
            on_press=self.show_cart,
            style=Pack(padding=10)
        )
        main_box.add(cart_button)

        # تعيين النافذة الرئيسية
        self.main_window = toga.MainWindow(title=self.formal_name)
        self.main_window.content = main_box
        self.main_window.show()

    def display_products(self):
        """عرض قائمة المنتجات."""
        self.product_list.children.clear()
        for product in self.products:
            product_box = toga.Box(style=Pack(direction=ROW, padding=(0, 5)))

            product_label = toga.Label(
                f"{product['name']} - {product['price']} ريال",
                style=Pack(padding=(0, 5), flex=1)
            )
            add_to_cart_button = toga.Button(
                "أضف إلى السلة",
                on_press=lambda w, p=product: self.add_to_cart(p),
                style=Pack(padding=(0, 5))
            )

            product_box.add(product_label)
            product_box.add(add_to_cart_button)
            self.product_list.add(product_box)

    def add_to_cart(self, product):
        """إضافة منتج إلى السلة."""
        self.cart.append(product)
        self.main_window.info_dialog(
            "تمت الإضافة",
            f"تم إضافة {product['name']} إلى السلة!"
        )

    def show_cart(self, widget):
        """عرض محتويات السلة."""
        cart_content = "\n".join(
            [f"{item['name']} - {item['price']} ريال" for item in self.cart]
        )
        total_price = sum(item['price'] for item in self.cart)
        message = f"السلة:\n{cart_content}\n\nالإجمالي: {total_price} ريال"

        self.main_window.info_dialog("سلة التسوق", message)


def main():
    return ECommerceApp()
